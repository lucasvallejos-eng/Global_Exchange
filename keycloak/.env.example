# =============================================================================
# keycloak/.env.example — variables de infraestructura del docker-compose
# =============================================================================
# Copiá este archivo a .env (en esta misma carpeta) y completá los valores.
#   cd keycloak && cp .env.example .env
#
# keycloak/.env está en .gitignore (regla .env* de la raíz) y NUNCA se commitea.
# Este .env.example sí se commitea: documenta qué variables hacen falta, sin
# valores reales.
#
# OJO: estas son variables de INFRA (contenedores). Las variables de la app
# (client id/secret de Keycloak para Django/React) están en el .env.example de
# la raíz del repo, no acá.
# =============================================================================

# --- PostgreSQL (base de datos de Keycloak) ----------------------------------
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
# Elegí una contraseña para la base local. Para desarrollo alcanza cualquiera.
POSTGRES_PASSWORD=

# --- Admin inicial de la consola de Keycloak ---------------------------------
# Con esto entrás a http://localhost:8080
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
