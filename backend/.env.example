# =============================================================================
# backend/.env.example — variables del backend Django
# =============================================================================
# Copiá a .env y completá:  cd backend && cp .env.example .env
# backend/.env está en .gitignore (regla .env* de la raíz). NUNCA se commitea.
# =============================================================================

# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=cambiar-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Keycloak (client confidential global-exchange-web) ----------------------
# El issuer es {servidor}/realms/{realm}
KEYCLOAK_ISSUER=http://localhost:8080/realms/GlobalExchange
KEYCLOAK_WEB_CLIENT_ID=global-exchange-web
# El secret se copia de: Keycloak -> Clients -> global-exchange-web -> Credentials
KEYCLOAK_WEB_CLIENT_SECRET=

# --- Maqueta (frontend React) ------------------------------------------------
# A dónde se manda al usuario después de loguearse.
MAQUETA_URL=http://localhost:8443/

# --- Stripe (modo test) ------------------------------------------------------
# NO van acá: van en backend/.env.stripe (levantar_todo.py borra este .env).
#   STRIPE_PUBLISHABLE_KEY=pk_test_...
#   STRIPE_SECRET_KEY=sk_test_...
# Se sacan de https://dashboard.stripe.com/test/apikeys
