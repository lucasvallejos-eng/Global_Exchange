# =============================================================================
# backend/.env.facturasegura.example — facturación electrónica (Factura Segura)
# =============================================================================
# Copiá este archivo a backend/.env.facturasegura y completalo:
#
#     cd backend && cp .env.facturasegura.example .env.facturasegura      (Linux / Mac)
#     cd backend && copy .env.facturasegura.example .env.facturasegura    (Windows)
#
# backend/.env.facturasegura está en .gitignore: NUNCA se sube al repo.
# levantar_todo.py no lo borra (solo borra los archivos llamados ".env").
#
# Sin este archivo el sistema funciona igual: las facturas quedan SIMULADAS
# (se ven en pantalla, pero no existen en Factura Segura ni en el SIFEN).
#
# -----------------------------------------------------------------------------
# OJO: los números de factura son pocos
# -----------------------------------------------------------------------------
# La cátedra le asignó al equipo 12 facturas (001-003-0000382 a 0000393) y 12
# notas de crédito (0000157 a 0000168). Cada factura emitida gasta un número.
# Por eso hay dos llaves:
#
#   - FACTURA_SEGURA_TOKEN: con el token, cada factura se VALIDA contra
#     Factura Segura (operación calcular_de), que no genera ningún documento ni
#     gasta números.
#   - FACTURA_SEGURA_EMITIR=1: recién con esto se EMITE de verdad. Dejalo en 0
#     salvo para la prueba real y la demo.
#
# Los tests nunca emiten ni salen a la red, tenga lo que tenga este archivo.
#
# -----------------------------------------------------------------------------
# Cómo conseguir el token
# -----------------------------------------------------------------------------
# 1. Registrar el usuario ESI en https://test.facturasegura.com.py con el
#    correo que la cátedra autorizó para el equipo.
# 2. Pedir el token (queda activo hasta que se cambie la contraseña):
#
#      curl -X POST "https://apitest.facturasegura.com.py/login?include_auth_token" \
#        -H "Content-Type: application/json" \
#        -d '{"email":"EL_CORREO","password":"LA_CONTRASEÑA"}'
#
#    El token es response.user.authentication_token.
# 3. Pegarlo abajo. Pasarlo a los compañeros por un canal privado, nunca por
#    el repo.
#
# Especificación: "API de Factura Segura para ESI v01".
# =============================================================================

# Ambiente de pruebas. Producción sería https://api.facturasegura.com.py
FACTURA_SEGURA_URL=https://apitest.facturasegura.com.py
FACTURA_SEGURA_TOKEN=
# 0 = simular (no gasta números). 1 = emitir de verdad.
FACTURA_SEGURA_EMITIR=0

# --- Emisor (los datos que entregó la cátedra) --------------------------------
# RUC sin dígito verificador, y el dígito aparte.
FACTURA_SEGURA_EMISOR_RUC=
FACTURA_SEGURA_EMISOR_DV=
# 1 = persona física, 2 = persona jurídica.
FACTURA_SEGURA_EMISOR_TIPO_CONTRIBUYENTE=1
FACTURA_SEGURA_EMISOR_NOMBRE=
FACTURA_SEGURA_EMISOR_DIRECCION=
FACTURA_SEGURA_EMISOR_NUMERO_CASA=0
# Códigos de departamento y ciudad del Manual Técnico del SIFEN.
FACTURA_SEGURA_EMISOR_DEPARTAMENTO_CODIGO=1
FACTURA_SEGURA_EMISOR_DEPARTAMENTO=CAPITAL
FACTURA_SEGURA_EMISOR_CIUDAD_CODIGO=1
FACTURA_SEGURA_EMISOR_CIUDAD=ASUNCION (DISTRITO)
FACTURA_SEGURA_EMISOR_TELEFONO=
FACTURA_SEGURA_EMISOR_EMAIL=
# Actividad económica del emisor (código y descripción de su constancia de RUC).
FACTURA_SEGURA_EMISOR_ACTIVIDAD_CODIGO=
FACTURA_SEGURA_EMISOR_ACTIVIDAD=

# --- Timbrado y numeración ----------------------------------------------------
FACTURA_SEGURA_TIMBRADO=
# Fecha de inicio del timbrado, AAAA-MM-DD.
FACTURA_SEGURA_TIMBRADO_INICIO=
FACTURA_SEGURA_ESTABLECIMIENTO=001
FACTURA_SEGURA_PUNTO_EXPEDICION=003
# Rango de facturas asignado al equipo.
FACTURA_SEGURA_FACTURA_DESDE=382
FACTURA_SEGURA_FACTURA_HASTA=393
