# =============================================================================
# Global Exchange — plantilla de variables de entorno
# =============================================================================
# Copiá este archivo a .env y completá los valores reales.
#   cp .env.example .env
#
# .env está en .gitignore (.env*) y NUNCA se commitea. Este .env.example sí se
# commitea (documenta qué variables hacen falta), por eso NO lleva secretos.
# =============================================================================


# --- Keycloak: servidor y realm (igual para las tres opciones A/B/C) ---------
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=GlobalExchange
# URL base del realm (útil para descubrir los endpoints OIDC):
#   {SERVER_URL}/realms/{REALM}/.well-known/openid-configuration
KEYCLOAK_ISSUER=http://localhost:8080/realms/GlobalExchange


# --- Client confidential: global-exchange-web (opciones A y C, Django) --------
# El secret se copia de Keycloak → Clients → global-exchange-web → Credentials.
# Dejalo VACÍO en este archivo; el valor real va solo en tu .env local.
KEYCLOAK_WEB_CLIENT_ID=global-exchange-web
KEYCLOAK_WEB_CLIENT_SECRET=
KEYCLOAK_WEB_REDIRECT_URI=http://localhost:8000/oidc/callback/


# --- Client public: global-exchange-spa (opción B, React SPA + PKCE) ---------
# Public client: no tiene secret (PKCE S256).
KEYCLOAK_SPA_CLIENT_ID=global-exchange-spa
KEYCLOAK_SPA_REDIRECT_URI=http://localhost:5173/*


# --- SSO con Google (opcional, si se habilita el identity provider) ----------
# Referenciado en la guía de la cátedra ("Django SSO con Google").
# Configurar solo si el equipo activa login con Google en Keycloak.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# --- Django (se completa cuando exista el backend; opciones A y C) -----------
# Placeholder; recién aplica cuando se cree el proyecto Django.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
