# Override local de Docker Compose para Keycloak (puertos especificos de esta
# maquina). No es parte de la infra compartida del equipo.
/keycloak/docker-compose.override.yml

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

# Documentación generada por Sphinx. El HTML se reconstruye con
#   cd docs && ../backend/.venv/Scripts/python -m sphinx -b html . _build/html
# así que no tiene sentido versionarlo.
/docs/_build/

# Estáticos que junta collectstatic para producción (se regeneran al construir).
/backend/staticfiles/
