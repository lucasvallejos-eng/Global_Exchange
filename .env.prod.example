# Variables del ambiente de producción (docker-compose.prod.yml).
# Copiar a .env.prod y completar. .env.prod NO se commitea (está en .gitignore).

# --- Direcciones públicas: como entra el navegador al servidor ---------------
# Reemplazar "servidor" por la IP o el dominio de la máquina.
URL_BACKEND=http://servidor:8000
URL_MAQUETA=http://servidor:8443
URL_KEYCLOAK=http://servidor:8080

# Puertos del servidor (tienen que coincidir con las URL de arriba).
PUERTO_BACKEND=8000
PUERTO_MAQUETA=8443
PUERTO_KEYCLOAK=8080

# --- Django -----------------------------------------------------------------
# Generar una clave nueva, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# El nombre o la IP del servidor, sin http:// ni puerto (varios, separados por coma).
DJANGO_ALLOWED_HOSTS=servidor
# 1 solo si el servidor tiene HTTPS adelante; con HTTP plano dejar en 0.
DJANGO_HTTPS=0

# --- Keycloak ---------------------------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=cambiar-por-una-contrasena-segura
POSTGRES_PASSWORD=cambiar-por-otra-contrasena-segura
# El secreto con el que Django se identifica ante Keycloak. Lo carga en
# Keycloak el script keycloak/configurar_produccion.py (ver la guía).
KEYCLOAK_WEB_CLIENT_SECRET=cambiar-por-otro-secreto-largo
